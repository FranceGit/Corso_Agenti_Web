// Laboratorio dell'Officina su GitHub Codespaces (piano gratuito: 120 ore-core al mese = 60 ore su 2 core).
// _why di ogni scelta nei commenti: questo file e' anche la soluzione di riferimento dell'esercizio 12.
{
  "name": "Officina - corso agenti AI",
  // immagine con tag fisso (Python 3.12 su Debian bookworm): lo stesso ambiente oggi e fra sei mesi
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // Docker dentro il codespace, per O1 (Dockerfile e compose) e O2 (il CRM adottato in container)
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // 2 core: il minimo di Codespaces e il piu' lungo con le ore gratuite
  "hostRequirements": { "cpus": 2 },
  // tutto pronto all'apertura: dipendenze dei test e dell'assistente
  "postCreateCommand": "pip install --user -r requirements.txt",
  // 8000 = CRM degli esercizi O1/O2, 8025 = interfaccia della posta finta (Mailpit)
  "forwardPorts": [8000, 8025],
  "portsAttributes": {
    "8000": { "label": "CRM dell'Officina" },
    "8025": { "label": "Posta finta (Mailpit)" }
  },
  // il segreto si DICHIARA qui e si imposta in Settings -> Codespaces -> Secrets: il valore non entra mai nel repo
  "secrets": {
    "GROQ_API_KEY": {
      "description": "Chiave GRATUITA di Groq (console.groq.com). Serve solo con ASSISTENTE_BACKEND=groq: senza, l'assistente usa il backend finto."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
