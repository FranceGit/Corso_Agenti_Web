# Copia questo file come ".env" (stessa cartella) solo se vuoi cambiare i valori predefiniti.
# Gli script avvia_laboratorio.ps1 / .sh impostano gia' LLM_URL e MODELLO secondo il parametro -Modello.

# Modello: finto (predefinito, nessuna GPU)
LLM_URL=http://finto-llm:11434
MODELLO=finto-llm-v1

# Modello vero nel laboratorio (profilo ollama):
# LLM_URL=http://ollama:11434
# MODELLO=qwen2.5:3b

# Ollama condiviso d'aula su un altro PC (sostituisci l'indirizzo):
# LLM_URL=http://192.168.1.50:11434
# MODELLO=qwen2.5:7b

PORTA_PORTALE=8780
PORTA_MAILPIT=8025
PORTA_CRM=8790
PORTA_OLLAMA=11434
MAILPIT_VERSIONE=v1.20.0
OLLAMA_VERSIONE=0.5.7
